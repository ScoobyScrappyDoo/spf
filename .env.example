# Your settings for the game on the NAS. Copy this file to .env (same folder) and fill it in.
# .env stays on your laptop and the NAS: git ignores it, so it never goes to GitHub.

# The session code: say it on the call, change it for every session (at least 6 characters).
# The server refuses to start while it still says change-me.
SIGNIN_CODE=change-me

# Who may sign in: addresses separated by commas. " admin" after yours (master seat, End any game).
ALLOWED_EMAILS=you@example.com admin, friend@example.com
